# Copy to .env — never commit the real file.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://lifey:change-me@db:5432/lifey
HEALTH_TIMEZONE=Asia/Phnom_Penh

# Garmin Connect account used by the sync job.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Money module: external ABA statement importer (feeds Sure).
ENABLE_BANK_IMPORT=0
SURE_IMPORT_DIR=./.none
SURE_IMPORT_PYTHON=/opt/sure_import/venv/bin/python
SURE_IMPORT_SCRIPT=/opt/sure_import/bank_statement_import.py

# App login. Accounts are created with: python -m app.auth.cli create-user <name>
# Origins allowed to make state-changing requests (comma separated).
APP_ORIGINS=http://localhost:3000,http://localhost:8100
# Set to 0 only for plain-http local development.
AUTH_COOKIE_SECURE=1
# NEVER set AUTH_DISABLED=1 on a server: it opens every API route.

# Public address of the web app. The bot links to /review from its Sunday nudge.
WEB_URL=http://localhost:3000
# Weekly review nudge, HH:MM local time on Sundays, or 'off'.
WEEKLY_REVIEW_TIME=19:00
